# PROVEX Configuration (Local Offline Defaults)
PROVEX_ENV=development
PROVEX_HOST=127.0.0.1
PROVEX_PORT=8000
PROVEX_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Data Adapter Mode: 'synthetic' (default offline) or 'linuxone_db2_stub'
PROVEX_DATA_ADAPTER=synthetic

# Audit Configuration (SHA-256)
PROVEX_AUDIT_ALGORITHM=SHA256
PROVEX_AUDIT_SALT=local-audit-salt-offline-only
